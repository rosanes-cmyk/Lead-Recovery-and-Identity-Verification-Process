# Lead Recovery & Seller Identity Verification Automation — configuration.
# Copy this file to ".env" and adjust as needed. Never put passwords here —
# the operator logs in manually in the browser window; the app stores no
# credentials.

# ---------------------------------------------------------------------------
# Safety flags. These control whether the app is allowed to make real changes.
# The whole point of the first version is that everything stays FALSE / dry-run:
# the app researches and prepares, but a human approves and executes.
# ---------------------------------------------------------------------------
LIVE_MODE=false          # false = never write to any CRM
DRY_RUN=true             # true = prepare only, make no changes
AUTO_OUTREACH=false      # never contact anyone automatically
AUTO_SAVE_NOTE=false     # never save the REI BlackBook note automatically
AUTO_CHANGE_STATUS=false # never change the lead status automatically
AUTO_CREATE_TASK=false   # never create the next task automatically
AUTO_REASSIGN=false      # never reassign the lead automatically

# People search stays OFF until Cherry Hombre approves an aggregator IN WRITING.
# When enabled, results are treated as clues only and cross-checked with
# official / property-data sources.
PEOPLE_SEARCH_ENABLED=false

# ---------------------------------------------------------------------------
# Demo mode: explore the whole flow with synthetic data and NO real browser or
# logins. Great for a first look. Set to false to run real investigations.
# ---------------------------------------------------------------------------
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Browser automation
# ---------------------------------------------------------------------------
# HEADLESS=false shows the browser so the operator can log in when prompted.
# Keep this false on the operator's machine.
HEADLESS=false
# Persistent profile directory. Logins persist here between runs so the
# operator does not have to sign in every time. This folder can contain
# session cookies — keep it private and never commit it.
USER_DATA_DIR=.browser-profile
# Optional: use real Google Chrome instead of the bundled Chromium.
# Leave blank to use Playwright's Chromium. Set to "chrome" for installed Chrome.
CHROME_CHANNEL=

# ---------------------------------------------------------------------------
# Investigation time limits (minutes). Enhanced requires approval.
# ---------------------------------------------------------------------------
STANDARD_TIME_LIMIT_MIN=30
ENHANCED_TIME_LIMIT_MIN=60

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4319
